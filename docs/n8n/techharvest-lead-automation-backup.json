        "messages": {
          "values": [
            {
              "content": "=Analyze this TechHarvest lead and qualify the prospect for our sales CRM.\n\nLead information:\n\nName: {{$json.fullName}}\nEmail: {{$json.email}}\nPhone: {{$json.phone}}\nSource: {{$json.source}}\nInterest: {{$json.interest}}\nMessage: {{$json.message}}\n\nDetermine:\n\n1. lead_quality: classify the lead as either \"high\" or \"low\".\n2. intent: classify the buying/business intent as either \"high\" or \"low\".\n3. lead_stage: identify the current stage of the prospect.\n4. summary: give a short explanation of what the prospect wants.\n5. next_action: recommend the most appropriate next sales action.\n6. reply: write a helpful, professional response to the prospect.\n\nImportant:\n- Do not invent information.\n- Use only the information supplied by the lead.\n- Return ONLY valid JSON.\n- Do not use Markdown code fences.\n- Do not include any explanation outside the JSON.\n\nReturn exactly this structure:\n\n{\n  \"lead_quality\": \"high or low\",\n  \"intent\": \"high or low\",\n  \"lead_stage\": \"\",\n  \"summary\": \"\",\n  \"next_action\": \"\",\n  \"reply\": \"\"\n}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        -80,
        16
      ],
      "id": "cf6e01db-4a7f-4ebe-a87b-4ee3cfdc1fb9",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "Ikvtm8oFhI9JLcEO",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\n\n// Gemini response is inside content.parts[0].text\nconst text =\n  input?.content?.parts?.[0]?.text ??\n  input?.parts?.[0]?.text ??\n  input?.text ??\n  \"\";\n\nif (!text) {\n  throw new Error(\n    \"Gemini response text could not be found. Check the Gemini node output.\"\n  );\n}\n\n// Remove markdown code fences if Gemini returns them\nconst cleanedText = text\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\nlet result;\n\ntry {\n  result = JSON.parse(cleanedText);\n} catch (error) {\n  throw new Error(\n    \"Gemini returned text, but it was not valid JSON.\\n\\nGemini response:\\n\" +\n    cleanedText\n  );\n}\n\nreturn [\n  {\n    json: result\n  }\n];"
      },
